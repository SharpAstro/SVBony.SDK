<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A HARDWARE probe for the binding, against an SVBONY camera that must be plugged in. NOT part of the
    package build and not run by CI. Run it by hand, with nothing else holding the camera:
      dotnet run -c Release (two dashes) info | raw | dal | cool
    See the README ("The probe") for what each arm does and the numbers it gave.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\SVBony.SDK.csproj" />
    <PackageReference Include="System.IO.Ports" Version="9.0.0" />
  </ItemGroup>

</Project>
